# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=kyb
DB_PASSWORD=kyb
DB_NAME=kyb

# --- ANAF public web service ---
# Version is configurable on purpose: the specification (section 4.1) warns that the
# service version may no longer be v9 and that field names must be verified against
# static.anaf.ro before relying on them.
ANAF_BASE_URL=https://webservicesp.anaf.ro/api/PlatitorTvaRest
ANAF_API_VERSION=v9
ANAF_TIMEOUT_MS=10000
ANAF_USER_AGENT=KYB-Module/1.0
ANAF_MIN_INTERVAL_MS=1000
ANAF_MAX_RETRIES=3

# --- App ---
PORT=3000
